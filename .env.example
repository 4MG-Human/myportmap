# انسخ هذا الملف إلى .env وعدّل القيم
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:////opt/myportmap/data/myportmap.db

# عنوان الـVPS العام (يظهر للمستخدمين كـpublic host)
VPN_PUBLIC_IP=YOUR_VPS_PUBLIC_IP
VPN_PORT=1194
VPN_PROTO=udp

# مسار PKI الخاص بـeasy-rsa على السيرفر
EASYRSA_DIR=/etc/openvpn/easy-rsa
PKI_DIR=/etc/openvpn/easy-rsa/pki
OPENVPN_SERVER_DIR=/etc/openvpn/server

# شبكة الـVPN
VPN_SUBNET_BASE=10.8.0

# نطاق المنافذ العامة التي يوزعها MyPortMap تلقائيًا
PORT_RANGE_START=40000
PORT_RANGE_END=50000

# جدول nftables المخصص للمشروع
NFT_TABLE=myportmap
